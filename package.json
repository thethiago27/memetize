{
  "name": "memetize",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "cli": "tsx apps/cli/src/index.ts",
    "db:generate": "pnpm --filter @memetize/database db:generate",
    "db:migrate": "pnpm --filter @memetize/database db:migrate",
    "py:sync": "cd workers/scene-detector && uv sync",
    "py:test": "cd workers/scene-detector && uv run pytest -q",
    "fixture": "bash scripts/generate-fixture.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}

{
  "name": "memetize",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "REQUIRE_INTEGRATION_TESTS=1 vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "cli": "tsx apps/cli/src/index.ts",
    "api": "tsx apps/api/src/index.ts",
    "web": "pnpm --filter @memetize/web dev",
    "studio": "turbo run dev --filter=@memetize/api --filter=@memetize/web",
    "db:generate": "pnpm --filter @memetize/database db:generate",
    "db:migrate": "pnpm --filter @memetize/database db:migrate",
    "py:sync": "pnpm py:sync:protocol && pnpm py:sync:scene-detector && pnpm py:sync:transcript && pnpm py:sync:audio-analyzer",
    "py:sync:protocol": "cd workers/python-shared && uv sync",
    "py:sync:scene-detector": "cd workers/scene-detector && uv sync",
    "py:sync:transcript": "cd workers/transcript && uv sync",
    "py:sync:audio-analyzer": "cd workers/audio-analyzer && uv sync",
    "py:test": "pnpm py:test:protocol && pnpm py:test:scene-detector && pnpm py:test:transcript && pnpm py:test:audio-analyzer",
    "py:test:protocol": "cd workers/python-shared && uv run pytest -q",
    "py:test:scene-detector": "cd workers/scene-detector && uv run pytest -q",
    "py:test:transcript": "cd workers/transcript && uv run pytest -q",
    "py:test:audio-analyzer": "cd workers/audio-analyzer && uv run pytest -q",
    "fixture": "bash scripts/generate-fixture.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}

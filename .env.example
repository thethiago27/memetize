# PostgreSQL (matches docker-compose.yml; host port 5433 avoids clashing with a local 5432)
DATABASE_URL=postgres://memetize:memetize@localhost:5433/memetize

# Optional separate database for integration tests. When unset, DB-dependent tests are skipped.
TEST_DATABASE_URL=

# Root for all media blobs (assets, frames, renders, temp, ...)
STORAGE_PATH=./storage

# Resource scheduler slots (one heavy GPU/render workload at a time on the M4)
MAX_CPU_LIGHT_WORKERS=4
MAX_CPU_HEAVY_WORKERS=1
MAX_GPU_WORKERS=1
MAX_IO_WORKERS=4
MAX_RENDER_WORKERS=1

# Model providers (unused in phase 0+1, reserved for later phases)
VISION_PROVIDER=
VISION_MODEL=
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
LLM_PROVIDER=
LLM_MODEL=

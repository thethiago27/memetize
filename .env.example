# PostgreSQL (matches docker-compose.yml; host port 5433 avoids clashing with a local 5432)
DATABASE_URL=postgres://memetize:memetize@localhost:5433/memetize

# Optional separate database for integration tests. When unset, DB-dependent tests are skipped.
TEST_DATABASE_URL=

# Root for all media blobs (assets, frames, renders, temp, ...)
STORAGE_PATH=./storage

# Resource scheduler slots (one heavy GPU/render workload at a time on the M4)
MAX_CPU_LIGHT_WORKERS=4
MAX_CPU_HEAVY_WORKERS=1
MAX_GPU_WORKERS=1
MAX_IO_WORKERS=4
MAX_RENDER_WORKERS=1

# Provider mode. "demo" (default) allows fixture providers; "production" refuses
# to start a worker whose vision/LLM/embedding capability is still a fixture
# (CAPABILITY_NOT_READY), so a demo build can never pass for a real one.
PROVIDER_MODE=demo

# Model providers. Empty (or "fixture") keeps vision/transcript/moment
# extraction deterministic and free of GPU/API calls (spec section 66).
# "gateway" routes the capability through the Vercel AI Gateway; the model is a
# gateway id (creator/model), e.g. anthropic/claude-sonnet-4.5 for VISION_MODEL
# and LLM_MODEL, openai/text-embedding-3-small for EMBEDDING_MODEL.
VISION_PROVIDER=
VISION_MODEL=
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_MODEL=
LLM_PROVIDER=
LLM_MODEL=
# Required when any of VISION_PROVIDER, LLM_PROVIDER or EMBEDDING_PROVIDER is
# "gateway". The AI SDK also reads this from the env.
AI_GATEWAY_API_KEY=

# Embedding provider used by the EMBED worker and the retriever (spec section
# 66). Empty (or "fixture") keeps `search` deterministic and free of GPU/API
# calls; vector width is a fixed constant (EMBEDDING_DIMENSIONS = 384), not an
# env var. The gateway provider asks the model for exactly that width (OpenAI
# `dimensions`, Google `outputDimensionality`); a model that cannot produce 384
# dims fails with EMBEDDING_DIMENSION_MISMATCH instead of corrupting the index.
# Changing the model changes the vector space: re-run
# `pnpm cli asset reprocess <id> --from embeddings` for every asset.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# How often the API's maintenance loop finalizes expired job leases and drains
# runnable work (ms). Crashed attempts resume within this interval.
JOB_MAINTENANCE_INTERVAL_MS=30000

# Audio analyzer provider (spec section 25). Passed straight to the Python
# worker like TRANSCRIPTION_PROVIDER; empty (or "fixture") keeps beats/sections
# deterministic and free of librosa/GPU.
AUDIO_PROVIDER=
AUDIO_MODEL=

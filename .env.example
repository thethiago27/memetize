# PostgreSQL (matches docker-compose.yml; host port 5433 avoids clashing with a local 5432)
DATABASE_URL=postgres://memetize:memetize@localhost:5433/memetize

# Optional separate database for integration tests. When unset, DB-dependent tests are skipped.
TEST_DATABASE_URL=

# Root for all media blobs (assets, frames, renders, temp, ...)
STORAGE_PATH=./storage

# Resource scheduler slots (one heavy GPU/render workload at a time on the M4)
MAX_CPU_LIGHT_WORKERS=4
MAX_CPU_HEAVY_WORKERS=1
MAX_GPU_WORKERS=1
MAX_IO_WORKERS=4
MAX_RENDER_WORKERS=1

# Model providers. Empty (or "fixture") keeps vision/transcript/moment
# extraction deterministic and free of GPU/API calls (spec section 66).
VISION_PROVIDER=
VISION_MODEL=
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_MODEL=
LLM_PROVIDER=
LLM_MODEL=
# Required only when LLM_PROVIDER=gateway. The AI SDK reads this from the env.
AI_GATEWAY_API_KEY=

# Embedding provider used by the EMBED worker and the retriever (spec section
# 66). Empty (or "fixture") keeps `search` deterministic and free of GPU/API
# calls; vector width is a fixed constant (EMBEDDING_DIMENSIONS), not an env var.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# Audio analyzer provider (spec section 25). Passed straight to the Python
# worker like TRANSCRIPTION_PROVIDER; empty (or "fixture") keeps beats/sections
# deterministic and free of librosa/GPU.
AUDIO_PROVIDER=
AUDIO_MODEL=
